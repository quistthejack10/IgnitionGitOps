{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-mes.dev/schemas/flow.schema.json",
  "title": "Forge Flow Definition",
  "description": "A versioned, directed acyclic graph of nodes executed by the flow engine (Go). Authored in the web flow builder, stored as JSON, exportable for Git-based promotion (dev -> test -> prod).",
  "type": "object",
  "required": ["id", "name", "version", "status", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Stable flow id (UUID)." },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "description": "Monotonic version; full history retained for diff/rollback (FR-F4)." },
    "status": { "type": "string", "enum": ["draft", "published"], "description": "Draft/published lifecycle (FR-F4)." },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "description": "Directed connections between node ports. Must form a DAG.",
      "items": { "$ref": "#/$defs/edge" }
    },
    "annotations": {
      "type": "object",
      "description": "Free-form metadata (author, tags, template params).",
      "additionalProperties": true
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "category"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique within the flow." },
        "type": { "type": "string", "description": "Concrete node type, e.g. 'trigger.opcua', 'transform.expression', 'mes.createEntity', 'sink.uns'." },
        "category": {
          "type": "string",
          "enum": ["trigger", "transform", "logic", "mes", "sink"],
          "description": "Node catalog category (PRD FR-F2)."
        },
        "label": { "type": "string" },
        "config": { "type": "object", "description": "Node-type-specific configuration.", "additionalProperties": true },
        "idempotencyKey": {
          "type": "string",
          "description": "Optional template (e.g. '${event.id}') giving MES action nodes at-least-once safety (FR-F7)."
        },
        "position": {
          "type": "object",
          "description": "Canvas coordinates for the editor.",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "description": "Source as 'nodeId:portName'." },
        "to": { "type": "string", "description": "Target as 'nodeId:portName'." }
      }
    }
  }
}
